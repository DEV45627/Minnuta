SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development

# Shareable meeting links (no trailing slash)
# Local:     http://localhost:8000
# LAN test:  auto
# Production: https://minuta.example.com
MINUTA_BASE_URL=http://localhost:8000
MINUTA_PORT=8000

# Production: set to your HTTPS origin(s). Use * only for local/LAN.
CORS_ORIGINS=*

DATABASE_URL=sqlite:///./minuta.db
STORAGE_PATH=./storage
WHISPER_MODEL=tiny
AI_PROVIDER=demo
# OPENAI_API_KEY=

# WebRTC ICE
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN (recommended for internet meetings across restrictive NATs)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

RATE_LIMIT_PER_MINUTE=120
