# Production environment template for VPS + Docker
# Copy on your server:  cp .env.production.example .env
# Then edit every value marked CHANGE_ME

ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# Your public HTTPS URL (no trailing slash). Must match what users type in the browser.
# Example: https://minuta.yourdomain.com
MINUTA_BASE_URL=https://CHANGE_ME.yourdomain.com
MINUTA_PORT=8000

# Must match MINUTA_BASE_URL exactly (same host, https)
CORS_ORIGINS=https://CHANGE_ME.yourdomain.com

DATABASE_URL=sqlite:////data/minuta.db
STORAGE_PATH=/app/storage
WHISPER_MODEL=tiny
AI_PROVIDER=demo

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Recommended for phone / different-network video calls
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=CHANGE_ME
# TURN_PASSWORD=CHANGE_ME

RATE_LIMIT_PER_MINUTE=120
